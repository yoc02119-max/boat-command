    {
      "name": "trial",
      "patterns": ["試用", "試せる", "使える", "今日使える"]
    },
    {
      "name": "phase",
      "patterns": ["内訳", "項目別", "各項目"]
    },
    {
      "name": "progress",
      "patterns": ["進捗", "完成度", "何％", "何%"]
    },
    {
      "name": "next_task",
